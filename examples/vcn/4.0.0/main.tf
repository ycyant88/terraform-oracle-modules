module "vcn" {
  source                               = "oracle-terraform-modules/vcn/oci"
  version                              = "4.0.0"
  attached_drg_id                      = var.attached_drg_id
  compartment_id                       = var.compartment_id
  create_internet_gateway              = var.create_internet_gateway
  create_nat_gateway                   = var.create_nat_gateway
  create_service_gateway               = var.create_service_gateway
  defined_tags                         = var.defined_tags
  enable_ipv6                          = var.enable_ipv6
  enable_vcn_logging                   = var.enable_vcn_logging
  freeform_tags                        = var.freeform_tags
  internet_gateway_display_name        = var.internet_gateway_display_name
  internet_gateway_route_rules         = var.internet_gateway_route_rules
  label_prefix                         = var.label_prefix
  local_peering_gateways               = var.local_peering_gateways
  lockdown_default_seclist             = var.lockdown_default_seclist
  log_retention_duration               = var.log_retention_duration
  nat_gateway_display_name             = var.nat_gateway_display_name
  nat_gateway_public_ip_id             = var.nat_gateway_public_ip_id
  nat_gateway_route_rules              = var.nat_gateway_route_rules
  region                               = var.region
  service_gateway_display_name         = var.service_gateway_display_name
  subnets                              = var.subnets
  tenancy_id                           = var.tenancy_id
  vcn_byoipv6cidr_details              = var.vcn_byoipv6cidr_details
  vcn_cidrs                            = var.vcn_cidrs
  vcn_dns_label                        = var.vcn_dns_label
  vcn_ipv6private_cidr_blocks          = var.vcn_ipv6private_cidr_blocks
  vcn_is_oracle_gua_allocation_enabled = var.vcn_is_oracle_gua_allocation_enabled
  vcn_name                             = var.vcn_name
}
