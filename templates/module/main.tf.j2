terraform {
  required_providers {
    oci = {
      source  = "oracle/oci"
      version = "8.29.0"
    }
  }
}

provider "oci" {
  # Configuration options
}

module "{{ module_name }}" {
  source  = "{{ namespace }}/{{ module_name }}/{{ provider }}"
  version = "{{ version_name }}"
  {%- for var in inputs %}
  {{ var.name }} = var.{{ var.name }}
  {%- endfor %}
}
